# ==============================================================================
# GeoVault AI — Environment Configuration
# Smart India Hackathon 2026 — Problem Statement 26023
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=geovault_insecure_development_secret_key_sih2026

# PostgreSQL 16 + pgvector Database
POSTGRES_USER=geovault_admin
POSTGRES_PASSWORD=geovault_secure_pass
POSTGRES_DB=geovault
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Redis & Celery Message Broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local LLM Service (llama.cpp)
# IMPORTANT: LLM is strictly internal on docker network and never exposed publicly
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL_NAME=Qwen3-8B-Q4_K_M.gguf
LLM_MODEL_PATH=/models/Qwen3-8B-Q4_K_M.gguf
LLM_N_GPU_LAYERS=18
LLM_CTX_SIZE=2048
LLM_THREADS=6

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
